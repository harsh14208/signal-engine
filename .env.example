# signal-engine credentials — copy to `.env` and fill in. `.env` is gitignored.
#
# DEDICATED Alpaca PAPER account for forward-testing (Tier A5).
# Use a SEPARATE paper account from the parent project — sharing one account nets
# positions on overlapping tickers (SPY/GLD/…) and makes reconciliation meaningless.
# Get keys at https://app.alpaca.markets → (your paper account) → API Keys.
alpaca_se_api_key=PKxxxxxxxxxxxxxxxxxxxx
alpaca_se_api_secret=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Kimi (Moonshot AI) trade evaluation (optional). Required only when running
# execute_alpaca.py with --ai-evaluate. Falls back to OPENAI_API_KEY for a
# generic OpenAI-compatible endpoint if KIMI_API_KEY is unset.
kimi_api_key=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
kimi_api_base=https://api.moonshot.cn/v1

